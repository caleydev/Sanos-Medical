# Copy to .env.local and fill in. Never commit real values.

# Public site URL — used for metadata / canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# External patient portal, linked from Patient Resources (SPEC §3).
# TODO: replace with the practice's real portal URL.
NEXT_PUBLIC_PORTAL_URL=https://portal.example.com

# --- Calendly inline scheduler (client-side embed, no API key) ---
# Public: your Calendly event link (e.g. https://calendly.com/sanos/consult).
# The /contact page embeds it in an iframe so patients self-book. Leave unset to
# disable the widget (a placeholder shows; the request form still works).
# COMPLIANCE: the linked event must collect scheduling info ONLY (name, email,
# phone, non-medical reason) — standard Calendly is NOT HIPAA-eligible.
NEXT_PUBLIC_CALENDLY_URL=

# --- WhatsApp Business floating button (optional) ---
# Digits only, no "+" (wa.me format), e.g. 17862921402. Defaults to the clinic
# phone line in lib/site.ts; only set this if the WhatsApp number differs. Set
# to empty to hide the button.
# COMPLIANCE: WhatsApp is NOT HIPAA-eligible — keep the chat to scheduling/
# general questions, never symptoms or medical history.
# NEXT_PUBLIC_WHATSAPP_NUMBER=17862921402

# --- Supabase (lead capture only — wired up in a later phase) ---
# Public values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the client or commit. NOT used by the site —
# the insert route intentionally uses the anon key (insert-only RLS). Only
# provision this for admin tasks like deletion-request fulfillment.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Lead capture → Google Sheet (agents review & call prospects) ---
# Service-account credentials with edit access to the sheet. Share the sheet
# with GOOGLE_SERVICE_ACCOUNT_EMAIL. Leave unset to disable the sheet sink
# (submissions still store in Supabase). Keep GOOGLE_PRIVATE_KEY's literal "\n".
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=Prospects
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# --- Appointment-request email notifications (Amazon SES, optional) ---
# Sends the practice an email on each submission via SES. Leave FROM or TO unset
# to disable (no-op). The FROM address/domain MUST be verified in SES, and the
# account must be out of the SES sandbox to email unverified recipients.
# APPOINTMENT_NOTIFY_FROM=Sanos Website <noreply@sanosmedical.com>
# APPOINTMENT_NOTIFY_TO=team@example.com   # comma-separated for multiple recipients
# SES region (defaults to AWS_REGION, then us-east-1). Must match where the
# sending domain is verified.
# SES_REGION=us-east-1
#
# AWS credentials come from the standard provider chain — NOT stored here in
# production. On EC2, attach an IAM role with ses:SendEmail. Locally only, you
# may use:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
